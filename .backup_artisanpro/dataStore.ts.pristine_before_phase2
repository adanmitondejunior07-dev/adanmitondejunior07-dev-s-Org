  // ARTISANS - ONLY REAL REGISTERED ARTISANS
  async getArtisans(): Promise<Artisan[]> {
    await this.ensureHydrated();
    try {
      const deletedIds = this.getStored<string[]>('deleted_artisans_ids', []);
      // Colonnes publiques explicites (exclusion stricte de solde, cni_recto_url, cni_verso_url, selfie_url, atelier_url, kyc_status, abonnement_paye, abonnement_date, abonnement_expire_at, embedding)
      const PUBLIC_ARTISAN_COLUMNS = 'id, nom, telephone, whatsapp, metier, ville, commune, description, services, photos, tarif_min, verifie, badge_vert, note_moyenne, nombre_avis, disponible, is_verified, badge_bleu, is_fondateur, created_at';
      
      let data: any[] | null = null;
      let error: any = null;

      // 1. Interroger la vue sécurisée public_artisans (si déployée), sinon repli transparent sur artisans avec projection stricte
      try {
        const resView = await supabase.from('public_artisans').select(PUBLIC_ARTISAN_COLUMNS);
        if (!resView.error && resView.data && resView.data.length > 0) {
          data = resView.data;
        } else {
          const resTable = await supabase.from('artisans').select(PUBLIC_ARTISAN_COLUMNS);
          data = resTable.data;
          error = resTable.error;
        }
      } catch {
        const resTable = await supabase.from('artisans').select(PUBLIC_ARTISAN_COLUMNS);
        data = resTable.data;
        error = resTable.error;
      }

      let merged: Artisan[] = [];

      if (!error && data && data.length > 0) {
        const formatted: Artisan[] = data.map(a => ({
          id: a.id,
          nom: a.nom || 'Artisan Partenaire',
          telephone: a.telephone || a.whatsapp || '',
          whatsapp: a.whatsapp || a.telephone || '',
          metier: a.metier || 'Artisan',
          ville: a.ville || 'Abidjan',
          commune: a.commune || '',
          description: a.description || 'Artisan qualifié inscrit sur la plateforme ArtisanPro.',
          services: a.services || 'Prestations sur mesure',
          tarif_min: a.tarif_min || 15000,
          verifie: a.verifie ?? a.is_verified ?? false,
          badge_vert: a.badge_vert ?? true,
          badge_bleu: a.badge_bleu ?? false,
          is_verified: a.is_verified ?? false,
          is_fondateur: a.is_fondateur ?? false,
          note_moyenne: a.note_moyenne || 5.0,
          nombre_avis: a.nombre_avis || 0,
          disponible: a.disponible ?? true,
          photos: a.photos || [],
          created_at: a.created_at || new Date().toISOString()
        }));
        merged = [...formatted];
      }

      // Include newly registered artisans from profiles & profils tables with explicit public columns
      try {
        const { data: profs } = await supabase
          .from('profiles')
          .select('id, full_name, email, role, is_verified, badge_bleu, is_fondateur, created_at')
          .eq('role', 'artisan');

        if (profs && profs.length > 0) {
          const artisanIds = profs.map(p => p.id);
          const { data: profilsRows } = await supabase
            .from('profils')
            .select('id, nom_complet, metier, telephone, photo_profil, ville_pays')
            .in('id', artisanIds);

          const profilsMap = new Map((profilsRows || []).map(r => [r.id, r]));

          for (const p of profs) {
            if (!merged.some(m => m.id === p.id)) {
              const extra = profilsMap.get(p.id);
              merged.push({
                id: p.id,
                nom: extra?.nom_complet || p.full_name || p.email.split('@')[0],
                telephone: extra?.telephone || '+225 00000000',
                whatsapp: extra?.telephone || '+225 00000000',
                metier: extra?.metier || 'Artisan',
                ville: extra?.ville_pays ? extra.ville_pays.split(',')[0].trim() : 'Abidjan',
                description: 'Professionnel inscrit sur ArtisanPro Afrique.',
                services: 'Prestations artisanales',
                tarif_min: 10000,
                verifie: p.is_verified || false,
                badge_bleu: p.badge_bleu || false,
                note_moyenne: 5.0,
                nombre_avis: 0,
                disponible: true,
                photos: extra?.photo_profil ? [extra.photo_profil] : [],
                created_at: p.created_at
              });
            }
          }
        }
      } catch (e) {
        // silent
      }

      // Include custom artisans added via UI
      const customArtisans = this.getStored<Artisan[]>('custom_artisans', []);
      for (const ca of customArtisans) {
        if (!merged.some(m => m.id === ca.id)) {
          merged.push(ca);
        }
      }

      // Include locally registered artisans
      const localUsers = this.getRegisteredUsers();
      for (const u of localUsers) {
        if (u.role === 'artisan' && !merged.some(m => m.id === u.id)) {
          merged.push({
            id: u.id,
            nom: u.full_name || u.email.split('@')[0],
            telephone: u.telephone || '',
            whatsapp: u.telephone || '',
            metier: u.metier || 'Artisan',
            ville: u.ville || 'Abidjan',
            description: u.bio || 'Professionnel inscrit sur ArtisanPro Afrique.',
            services: 'Prestations sur mesure',
            tarif_min: 15000,
            verifie: u.is_verified || false,
            badge_bleu: u.badge_bleu || false,
            badge_vert: true,
            is_verified: u.is_verified || false,
            note_moyenne: 5.0,
            nombre_avis: 0,
            disponible: true,
            photos: u.avatar_url ? [u.avatar_url] : [],
            created_at: u.created_at || new Date().toISOString()
          });
        }
      }

      const seen = new Set<string>();
      return merged.filter(a => {
        if (deletedIds.includes(a.id)) return false;
        const nom = (a.nom || '').toLowerCase();
        if (nom.includes('konan')) return false;
        if (seen.has(a.id)) return false;
        seen.add(a.id);
        return true;
      });
    } catch {
      return [];
    }
  }

