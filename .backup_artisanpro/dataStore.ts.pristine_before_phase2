  async confirmGeniusPayRecharge(
    reference: string,
    confirmedAmount?: number
  ): Promise<{ success: boolean; transaction?: WalletTransaction; alreadyProcessed?: boolean; error?: string }> {
    await this.ensureHydrated();
    const allTxs = this.getStored<WalletTransaction[]>('wallet_transactions', []);
    const txIndex = allTxs.findIndex(t => t.reference === reference || t.provider_ref === reference);

    if (txIndex === -1) {
      return { success: false, error: 'Transaction non trouvée' };
    }

    const tx = allTxs[txIndex];

    // VERROU STRICT D'IDEMPOTENCE
    if (tx.status === 'completed') {
      return { success: true, transaction: tx, alreadyProcessed: true };
    }

    const creditAmount = confirmedAmount && confirmedAmount > 0 ? confirmedAmount : tx.amount_fcfa;

    // Lock status to completed
    const updatedTx: WalletTransaction = {
      ...tx,
      amount_fcfa: creditAmount,
      status: 'completed',
      confirmed_at: new Date().toISOString(),
      description: `Recharge GeniusPay Sandbox (${creditAmount.toLocaleString('fr-FR')} FCFA) - Confirmée`
    };

    allTxs[txIndex] = updatedTx;
    this.setStored('wallet_transactions', allTxs);

    // Credit user's wallet
    const wallets = this.getStored<Record<string, UserWallet>>('wallets', {});
    const userWallet = await this.getWallet(tx.user_id);
    userWallet.balance_fcfa += creditAmount;
    userWallet.updated_at = new Date().toISOString();
    wallets[tx.user_id] = userWallet;
    this.setStored('wallets', wallets);

    // Add confirmed notification
    await this.addNotification({
      user_id: tx.user_id,
      title: 'Recharge GeniusPay confirmée ✅',
      message: `Votre portefeuille a été crédité de ${creditAmount.toLocaleString('fr-FR')} FCFA via GeniusPay Sandbox.`,
      type: 'system',
      created_at: new Date().toISOString()
    });

    return { success: true, transaction: updatedTx, alreadyProcessed: false };
  }

  async payArtisanFromWallet(
    clientId: string,
    artisanId: string,
    amount: number,
    missionId: string,
    description: string
  ): Promise<{ success: boolean; error?: string; clientTx?: WalletTransaction }> {
    await this.ensureHydrated();
    const integerAmount = Math.max(1, Math.round(amount));
    const clientWallet = await this.getWallet(clientId);

    if (clientWallet.balance_fcfa < integerAmount) {
      return { 
        success: false, 
        error: `Solde insuffisant (${clientWallet.balance_fcfa.toLocaleString('fr-FR')} FCFA). Veuillez recharger votre portefeuille.` 
      };
    }

    const settings = await this.getPlatformSettings();
    const commission = Math.round(integerAmount * (settings.commission_percent / 100));
    const artisanShare = integerAmount - commission;

    // 1. Debit Client
    const wallets = this.getStored<Record<string, UserWallet>>('wallets', {});
    clientWallet.balance_fcfa -= integerAmount;
    clientWallet.updated_at = new Date().toISOString();
    wallets[clientId] = clientWallet;

    // 2. Credit Artisan
    const artisanWallet = await this.getWallet(artisanId);
    artisanWallet.balance_fcfa += artisanShare;
    artisanWallet.updated_at = new Date().toISOString();
    wallets[artisanId] = artisanWallet;
    this.setStored('wallets', wallets);

    const ref = 'PAY-' + Date.now().toString(36).toUpperCase() + '-' + Math.floor(1000 + Math.random() * 9000);

    // 3. Transactions
    const clientTx: WalletTransaction = {
      id: 'tx-cli-' + Date.now(),
      wallet_id: clientWallet.id,
      user_id: clientId,
      type: 'payment',
      amount_fcfa: integerAmount,
      status: 'completed',
      provider: 'wallet_internal',
      reference: ref,
      description: description,
      mission_id: missionId,
      created_at: new Date().toISOString(),
      confirmed_at: new Date().toISOString()
    };

    const artisanTx: WalletTransaction = {
      id: 'tx-art-' + Date.now(),
      wallet_id: artisanWallet.id,
      user_id: artisanId,
      type: 'deposit',
      amount_fcfa: artisanShare,
      status: 'completed',
      provider: 'wallet_internal',
      reference: 'REC-' + ref,
      description: `Règlement mission (${artisanShare.toLocaleString('fr-FR')} FCFA net après commission)`,
      mission_id: missionId,
      created_at: new Date().toISOString(),
      confirmed_at: new Date().toISOString()
    };

    const allTxs = this.getStored<WalletTransaction[]>('wallet_transactions', []);
    this.setStored('wallet_transactions', [clientTx, artisanTx, ...allTxs]);

    // Send notifications
    await this.addNotification({
      user_id: clientId,
      title: 'Paiement effectué',
      message: `Paiement de ${integerAmount.toLocaleString('fr-FR')} FCFA validé.`,
      type: 'system',
      created_at: new Date().toISOString()
    });

    await this.addNotification({
      user_id: artisanId,
      title: 'Paiement reçu ✅',
      message: `Vous avez reçu ${artisanShare.toLocaleString('fr-FR')} FCFA pour votre intervention.`,
      type: 'system',
      created_at: new Date().toISOString()
    });

    return { success: true, clientTx };
  }

  async requestPayout(
    artisanId: string,
    amount: number,
    provider: PaymentProvider,
    phone: string,
    artisanName?: string
  ): Promise<{ success: boolean; error?: string; transaction?: WalletTransaction }> {
    await this.ensureHydrated();
    const integerAmount = Math.max(1000, Math.round(amount));
    const wallet = await this.getWallet(artisanId);

    if (wallet.balance_fcfa < integerAmount) {
      return { 
        success: false, 
        error: `Solde insuffisant pour ce retrait (${wallet.balance_fcfa.toLocaleString('fr-FR')} FCFA disponibles).` 
      };
    }

    // Deduct from available balance immediately to prevent double spending
    const wallets = this.getStored<Record<string, UserWallet>>('wallets', {});
    wallet.balance_fcfa -= integerAmount;
    wallet.updated_at = new Date().toISOString();
    wallets[artisanId] = wallet;
    this.setStored('wallets', wallets);

    const newTx: WalletTransaction = {
      id: 'tx-ret-' + Date.now(),
      wallet_id: wallet.id,
      user_id: artisanId,
      user_name: artisanName,
      type: 'payout',
      amount_fcfa: integerAmount,
      status: 'pending',
      provider: provider,
      reference: 'RET-' + Date.now().toString(36).toUpperCase() + '-' + Math.floor(1000 + Math.random() * 9000),
      provider_ref: phone,
      description: `Demande de retrait vers ${provider.replace('_', ' ').toUpperCase()} (${phone})`,
      created_at: new Date().toISOString()
    };

    const allTxs = this.getStored<WalletTransaction[]>('wallet_transactions', []);
    this.setStored('wallet_transactions', [newTx, ...allTxs]);

    return { success: true, transaction: newTx };
  }

  async adminApprovePayout(transactionId: string): Promise<boolean> {
    await this.ensureHydrated();
    const allTxs = this.getStored<WalletTransaction[]>('wallet_transactions', []);
    const idx = allTxs.findIndex(t => t.id === transactionId);
    if (idx >= 0 && allTxs[idx].status === 'pending') {
      allTxs[idx].status = 'completed';
      allTxs[idx].confirmed_at = new Date().toISOString();
      this.setStored('wallet_transactions', allTxs);

      await this.addNotification({
        user_id: allTxs[idx].user_id,
        title: 'Retrait validé ✅',
        message: `Votre retrait de ${allTxs[idx].amount_fcfa.toLocaleString('fr-FR')} FCFA a été transféré sur votre numéro ${allTxs[idx].provider_ref}.`,
        type: 'system',
        created_at: new Date().toISOString()
      });
      return true;
    }
    return false;
  }

  async adminRefundTransaction(transactionId: string): Promise<boolean> {
    await this.ensureHydrated();
    const allTxs = this.getStored<WalletTransaction[]>('wallet_transactions', []);
    const tx = allTxs.find(t => t.id === transactionId);
    if (!tx) return false;

    // Refund user wallet
    const wallet = await this.getWallet(tx.user_id);
    const wallets = this.getStored<Record<string, UserWallet>>('wallets', {});
    wallet.balance_fcfa += tx.amount_fcfa;
    wallet.updated_at = new Date().toISOString();
    wallets[tx.user_id] = wallet;
    this.setStored('wallets', wallets);

    const refundTx: WalletTransaction = {
      id: 'tx-ref-' + Date.now(),
      wallet_id: wallet.id,
      user_id: tx.user_id,
      type: 'refund',
      amount_fcfa: tx.amount_fcfa,
      status: 'completed',
      provider: tx.provider,
      reference: 'REF-' + tx.reference,
      description: `Remboursement de la transaction ${tx.reference}`,
      mission_id: tx.mission_id,
      created_at: new Date().toISOString(),
      confirmed_at: new Date().toISOString()
    };

    this.setStored('wallet_transactions', [refundTx, ...allTxs]);

    await this.addNotification({
      user_id: tx.user_id,
      title: 'Remboursement effectué 🔄',
      message: `Votre remboursement de ${tx.amount_fcfa.toLocaleString('fr-FR')} FCFA a été crédité sur votre portefeuille.`,
      type: 'system',
      created_at: new Date().toISOString()
    });

    return true;
  }

