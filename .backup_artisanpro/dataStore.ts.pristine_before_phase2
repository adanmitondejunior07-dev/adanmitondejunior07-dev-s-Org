  async getVideos(currentUserId?: string): Promise<VideoItem[]> {
    await this.ensureHydrated();
    const resolvedId = this.resolveUserUuid(currentUserId) || currentUserId;
    const userLikesKey = resolvedId ? `my_likes_${resolvedId}` : 'my_likes';
    const localLikes = this.getStored<string[]>(userLikesKey, this.getStored<string[]>('my_likes', []));

