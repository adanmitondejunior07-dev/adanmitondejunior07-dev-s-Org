    data: Omit<ServiceRequest, 'id' | 'created_at' | 'updated_at' | 'status'>
  ): Promise<ServiceRequest> {
    await this.ensureHydrated();
    const newReq: ServiceRequest = {
      ...data,
      id: 'req-' + Date.now() + '-' + Math.random().toString(36).substring(2, 6),
      status: data.type === 'urgent' && !data.is_urgency_paid ? 'pending_payment' : 'searching_artisan',
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    };

    const current = this.getStored<ServiceRequest[]>('service_requests', []);
    this.setStored('service_requests', [newReq, ...current]);
    return newReq;
