    const custom = this.getStored<VideoItem[]>('custom_videos', [])
      .filter(v => v.video_url && !deletedIds.includes(v.id));

    // Also fetch videos from Supabase publications table where media_type = 'video'
    let supaVideos: VideoItem[] = [];
    try {
      const { data: supaPubs, error } = await supabase
        .from('publications')
        .select('*')
        .eq('media_type', 'video')
        .order('created_at', { ascending: false });

      if (!error && supaPubs && supaPubs.length > 0) {
        supaVideos = supaPubs
          .filter(p => !deletedIds.includes(p.id))
