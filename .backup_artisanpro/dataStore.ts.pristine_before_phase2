  async syncFollowsWithDatabase(currentUserId: string): Promise<void> {
    if (!currentUserId) return;
    const myId = this.resolveUserUuid(currentUserId) || currentUserId;
    try {
      const { data: followRows } = await supabase
        .from('user_follows')
        .select('following_id')
        .eq('follower_id', myId);

      if (followRows && followRows.length > 0) {
        const followingIds = followRows.map((r: any) => r.following_id);
        const existing = this.getStored<string[]>(`following_${myId}`, []);
        this.setStored(`following_${myId}`, Array.from(new Set([...existing, ...followingIds])));
      }
    } catch (e) {
      // Table user_follows optional / local storage authoritative fallback
    }
  }

  toggleFollowUser(targetUserId: string, currentUserId?: string): { isFollowed: boolean; followersCount: number } {
    const myId = this.resolveUserUuid(currentUserId) || currentUserId || 'me';

    // Règle : Un utilisateur ne peut pas s'abonner à lui-même
    if (currentUserId && (targetUserId === currentUserId || targetUserId === myId)) {
      return { isFollowed: false, followersCount: this.getUserFollowersCount(targetUserId) };
    }

    const myFollows = this.getStored<string[]>(`following_${myId}`, []);
    const isFollowed = myFollows.includes(targetUserId);
    
    let followers = this.getUserFollowersCount(targetUserId);

    if (isFollowed) {
      this.setStored(`following_${myId}`, myFollows.filter(id => id !== targetUserId));
      followers = Math.max(0, followers - 1);
    } else {
      this.setStored(`following_${myId}`, Array.from(new Set([...myFollows, targetUserId])));
      followers = followers + 1;
    }

    this.setStored(`followers_count_${targetUserId}`, followers);

    // Sync to Supabase user_follows table in background if available
    if (myId && myId !== 'me' && targetUserId) {
      (async () => {
        try {
          if (isFollowed) {
            await supabase.from('user_follows').delete().eq('follower_id', myId).eq('following_id', targetUserId);
          } else {
            await supabase.from('user_follows').insert({ follower_id: myId, following_id: targetUserId });
          }
          // Fetch exact count via secure public RPC without exposing follower identities
          try {
            const { data: rpcCount, error: rpcErr } = await supabase.rpc('get_followers_count', { target_id: targetUserId });
            if (!rpcErr && typeof rpcCount === 'number') {
              this.setStored(`followers_count_${targetUserId}`, rpcCount);
            } else {
              const { count } = await supabase.from('user_follows').select('*', { count: 'exact', head: true }).eq('following_id', targetUserId);
              if (typeof count === 'number') {
                this.setStored(`followers_count_${targetUserId}`, count);
              }
            }
          } catch {}
        } catch (e) {
          // Table doesn't exist yet in Supabase, local state is securely maintained
        }
      })();
    }

    return { isFollowed: !isFollowed, followersCount: followers };
  }

  isUserLiked(targetUserId: string, currentUserId?: string): boolean {
    const myId = currentUserId || 'me';
