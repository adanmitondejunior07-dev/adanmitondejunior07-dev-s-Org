  // GUARANTEED SINGLE INSERT WITH ANTI-DOUBLE-CLICK LOCK & UNIQUE SUBMISSION TOKEN
  async sendMessage(
    conversationId: string,
    senderId: string,
    senderName: string,
    receiverId: string,
    text: string,
    uniqueToken: string,
    options?: {
      type?: 'text' | 'voice' | 'file' | 'image';
      media_url?: string;
      media_name?: string;
      media_size?: string;
      voice_duration?: number;
    }
  ): Promise<ChatMessage | null> {
    const cleanText = text.trim();
    if (!cleanText && !options?.media_url) return null;

    // Strict Anti-duplicate Lock
    if (this.pendingMessageTokens.has(uniqueToken)) {
      console.warn('Duplicate message submission blocked by token:', uniqueToken);
      return null;
    }
    this.pendingMessageTokens.add(uniqueToken);

    try {
      const canonicalSenderId = this.resolveUserUuid(senderId) || senderId;
      const canonicalReceiverId = this.resolveUserUuid(receiverId) || receiverId;
      const canonicalConvId = this.getCanonicalConversationId(canonicalSenderId, canonicalReceiverId);

      const newMsg: ChatMessage = {
        id: `msg-${Date.now()}-${Math.random().toString(36).substring(2, 7)}`,
        conversation_id: canonicalConvId,
        sender_id: canonicalSenderId,
        sender_name: senderName,
        receiver_id: canonicalReceiverId,
        text: cleanText || (options?.type === 'voice' ? '🎤 Message vocal' : options?.type === 'image' ? '📷 Image' : '📎 Fichier'),
        created_at: new Date().toISOString(),
        type: options?.type || 'text',
        media_url: options?.media_url,
        media_name: options?.media_name,
        media_size: options?.media_size,
        voice_duration: options?.voice_duration
      };

      // Try inserting into Supabase messages table if available
      try {
        const { data: supaMsg, error: supaErr } = await supabase.from('messages').insert({
          conversation_id: canonicalConvId,
          sender_id: canonicalSenderId,
          sender_name: senderName,
          receiver_id: canonicalReceiverId,
          text: newMsg.text,
          type: newMsg.type,
          media_url: newMsg.media_url || null,
          media_name: newMsg.media_name || null,
          media_size: newMsg.media_size || null,
          voice_duration: newMsg.voice_duration || null
        }).select().maybeSingle();

        if (!supaErr && supaMsg) {
          newMsg.id = supaMsg.id;
          newMsg.created_at = supaMsg.created_at;
        }
      } catch (err) {
        console.warn('Supabase message insert note:', err);
      }

      const key = `msgs_${canonicalConvId}`;
      const existing = this.getStored<ChatMessage[]>(key, []);
      // Check if exact message already exists in the last 2 seconds
      const isDuplicate = existing.some(
        m => m.sender_id === senderId && m.text === newMsg.text && Math.abs(new Date(m.created_at).getTime() - Date.now()) < 2000
      );

      if (isDuplicate) {
        console.warn('Duplicate message blocked by timestamp & content');
        return null;
      }

      this.setStored(key, [...existing, newMsg]);

      // Ensure conversation is in global admin index
      const adminConvIds = this.getStored<string[]>('all_admin_conv_ids', []);
      if (!adminConvIds.includes(canonicalConvId)) {
        this.setStored('all_admin_conv_ids', [canonicalConvId, ...adminConvIds]);
      }

      const nowTs = Date.now();
      const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      // Update conversation last message for sender & MOVE TO TOP
      const updateSenderStore = (sId: string) => {
        const convsKey = `convs_${sId}`;
        const convs = this.getStored<Conversation[]>(convsKey, []);
        const idx = convs.findIndex(c => c.id === canonicalConvId || c.contact_id === receiverId || c.contact_id === canonicalReceiverId);

        if (idx >= 0) {
          const updatedConv: Conversation = {
            ...convs[idx],
            id: canonicalConvId,
            last_message: cleanText,
            last_message_time: timeStr,
            last_message_timestamp: nowTs
          };
          const rest = convs.filter((_, i) => i !== idx);
          this.setStored(convsKey, [updatedConv, ...rest]);
        } else {
          const senderConv: Conversation = {
            id: canonicalConvId,
            contact_id: canonicalReceiverId,
            contact_name: 'Contact',
            contact_role: 'Membre ArtisanPro',
            last_message: cleanText,
            last_message_time: timeStr,
            last_message_timestamp: nowTs,
            unread_count: 0
          };
          this.setStored(convsKey, [senderConv, ...convs]);
        }
      };

      updateSenderStore(senderId);
      if (canonicalSenderId !== senderId) updateSenderStore(canonicalSenderId);

      // Also update receiver conversation preview & MOVE TO TOP
      const updateReceiverStore = (rId: string) => {
        if (!rId || rId === 'me') return;
        const rKey = `convs_${rId}`;
        const rConvs = this.getStored<Conversation[]>(rKey, []);
        const rIdx = rConvs.findIndex(c => c.id === canonicalConvId || c.contact_id === senderId || c.contact_id === canonicalSenderId);

        if (rIdx >= 0) {
          const updatedConv: Conversation = {
            ...rConvs[rIdx],
            id: canonicalConvId,
            last_message: cleanText,
            last_message_time: timeStr,
            last_message_timestamp: nowTs,
            unread_count: (rConvs[rIdx].unread_count || 0) + 1
          };
          const rest = rConvs.filter((_, i) => i !== rIdx);
          this.setStored(rKey, [updatedConv, ...rest]);
        } else {
          const mirrorConv: Conversation = {
            id: canonicalConvId,
            contact_id: canonicalSenderId,
            contact_name: senderName,
            contact_avatar: undefined,
            contact_role: 'Membre ArtisanPro',
            last_message: cleanText,
            last_message_time: timeStr,
            last_message_timestamp: nowTs,
            unread_count: 1
          };
          this.setStored(rKey, [mirrorConv, ...rConvs]);
        }
      };

      updateReceiverStore(receiverId);
      if (canonicalReceiverId !== receiverId) updateReceiverStore(canonicalReceiverId);

      // Broadcast update across tabs and active window
      if (typeof window !== 'undefined') {
        try {
          window.dispatchEvent(new CustomEvent('artisanpro_chat_update', {
            detail: {
              conversationId: canonicalConvId,
              senderId: canonicalSenderId,
              receiverId: canonicalReceiverId,
              message: newMsg
            }
          }));
        } catch {}
      }

      // Try broadcasting via Supabase Realtime channel
      try {
        const channel = supabase.channel(`chat_${canonicalConvId}`);
        await channel.send({
          type: 'broadcast',
          event: 'new_message',
          payload: newMsg
        });
      } catch (err) {
        // Broadcast non-blocking
      }

      return newMsg;
    } finally {
      setTimeout(() => {
        this.pendingMessageTokens.delete(uniqueToken);
      }, 1500);
    }
  }

