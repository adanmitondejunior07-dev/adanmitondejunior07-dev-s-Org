  async updateServiceRequest(requestId: string, updates: Partial<ServiceRequest>): Promise<ServiceRequest | null> {
    await this.ensureHydrated();
    const current = this.getStored<ServiceRequest[]>('service_requests', []);
    const idx = current.findIndex(r => r.id === requestId);
    if (idx >= 0) {
      current[idx] = {
        ...current[idx],
        ...updates,
        updated_at: new Date().toISOString()
      };
      this.setStored('service_requests', current);
      return current[idx];
    }
    return null;
  }

  // ALGORITHME DE DISTRIBUTION GPS INTELLIGENT
  async findNearbyAvailableArtisans(
    metier: string,
    clientLat: number,
    clientLng: number,
    maxRadiusKm?: number
  ): Promise<Array<{ artisan: Artisan; distanceKm: number }>> {
    await this.ensureHydrated();
    const allArtisans = await this.getArtisans();
    const settings = await this.getPlatformSettings();
    const radius = maxRadiusKm || settings.default_search_radius_km;

    // Check currently busy artisans
    const activeRequests = await this.getAllServiceRequests();
    const busyArtisanIds = new Set(
      activeRequests
        .filter(r => ['artisan_accepted', 'artisan_en_route', 'artisan_arrived', 'in_progress'].includes(r.status))
        .map(r => r.assigned_artisan_id)
        .filter(Boolean)
    );

    const results: Array<{ artisan: Artisan; distanceKm: number }> = [];

    for (const a of allArtisans) {
      // 1. Must match craft / metier
      if (metier !== 'Tous' && a.metier?.toLowerCase() !== metier.toLowerCase()) {
        continue;
      }

      // 2. Must not be suspended
      if (this.isUserSuspended(a.id)) {
        continue;
      }

      // 3. Must be available and not occupied on another mission
      if (a.disponible === false || busyArtisanIds.has(a.id)) {
        continue;
      }

      // 4. Calculate real distance using coordinates
      let dist = 3.5; // fallback average distance in km if no GPS
      if (a.gps_lat && a.gps_lng && clientLat && clientLng) {
        dist = this.computeDistanceKm(clientLat, clientLng, a.gps_lat, a.gps_lng);
      }

      if (dist <= radius) {
        results.push({ artisan: a, distanceKm: dist });
      }
    }

    // Sort by distance ascending
    return results.sort((a, b) => a.distanceKm - b.distanceKm);
  }

  computeDistanceKm(lat1: number, lon1: number, lat2: number, lon2: number): number {
    const R = 6371; // Earth's radius in km
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = 
      Math.sin(dLat / 2) * Math.sin(dLat / 2) +
      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * 
      Math.sin(dLon / 2) * Math.sin(dLon / 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    return Math.round(R * c * 10) / 10;
  }
