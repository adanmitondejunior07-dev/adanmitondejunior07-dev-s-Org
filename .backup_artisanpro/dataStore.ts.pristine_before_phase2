            likes_count: 0,
            comments_count: 0,
            created_at: p.created_at,
            user_id: p.user_id
          }));
      }
    } catch (e) {
      console.warn('Supabase getVideos note:', e);
    }

    // Also pull in any local publication created with media_type === 'video'
    const pubs = this.getStored<Publication[]>('custom_publications', []);
    const pubVideos: VideoItem[] = pubs
      .filter(p => p.media_type === 'video' && p.media_url && !deletedIds.includes(p.id))
      .map(p => ({
        id: p.id,
        title: p.content ? (p.content.slice(0, 60)) : 'Réalisation artisanale en vidéo',
        video_url: p.media_url!,
        poster_url: undefined,
        artisan_name: p.artisan_name,
        artisan_avatar: p.artisan_avatar || undefined,
        metier: 'Artisan',
        ville: p.location || 'Afrique',
        likes_count: p.likes_count || 0,
        comments_count: p.comments_count || 0,
        created_at: p.created_at,
        user_id: p.user_id
      }));

    const all = [...supaVideos, ...custom, ...pubVideos, ...INITIAL_VIDEOS.filter(v => !deletedIds.includes(v.id))];
    const seen = new Set<string>();
    const uniqueVideos = all.filter(v => {
      if (!v.id || seen.has(v.id)) return false;
      seen.add(v.id);
      return true;
    });

    // Check likes from Supabase for all videos that have a UUID
    const supaLikesSet = new Set<string>();
    const likesCountMap = new Map<string, number>();

    const uuidVideos = uniqueVideos.filter(v => /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(v.id));
    if (uuidVideos.length > 0) {
      try {
        const videoIds = uuidVideos.map(v => v.id);
        const { data: likesData, error: lkErr } = await supabase
          .from('likes')
          .select('post_id, user_id')
          .in('post_id', videoIds);

        if (!lkErr && likesData) {
          likesData.forEach((row: { post_id: string; user_id: string }) => {
            const currentC = likesCountMap.get(row.post_id) || 0;
            likesCountMap.set(row.post_id, currentC + 1);
            if (resolvedId && row.user_id === resolvedId) {
              supaLikesSet.add(row.post_id);
            }
          });
        }
      } catch (e) {
        console.warn('Supabase likes fetch for videos note:', e);
      }
    }

    return uniqueVideos.map(v => {
      const isPostUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(v.id);
      let isLiked = false;
      let realCount = 0;

      if (isPostUuid && resolvedId) {
        isLiked = supaLikesSet.has(v.id);
      } else {
        isLiked = localLikes.includes(v.id);
      }

      if (isPostUuid && likesCountMap.has(v.id)) {
        realCount = likesCountMap.get(v.id)!;
      } else {
        realCount = this.getStored<number>(`post_likes_${v.id}`, v.likes_count || 0);
      }

      return {
        ...v,
        likes_count: realCount,
        is_liked: isLiked
      };
    });
  }

