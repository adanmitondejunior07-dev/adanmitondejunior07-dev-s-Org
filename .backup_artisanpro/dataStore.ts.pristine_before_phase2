  async getServiceRequests(filter?: { clientId?: string; artisanId?: string }): Promise<ServiceRequest[]> {
    await this.ensureHydrated();
    const all = this.getStored<ServiceRequest[]>('service_requests', []);
    return all.filter(req => {
      if (filter?.clientId && req.client_id !== filter.clientId) return false;
      if (filter?.artisanId && req.assigned_artisan_id !== filter.artisanId) return false;
      return true;
    }).sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime());
  }

