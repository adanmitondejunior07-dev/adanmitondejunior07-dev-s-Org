const INITIAL_VIDEOS: VideoItem[] = [];

class DataStoreService {
  private memoryCache: Record<string, any> = {};
  private hydrationPromise: Promise<void> | null = null;

  constructor() {
    this.cleanUpKonanTest();
    this.purgeDemoFollowersAndLikes();
    this.hydrationPromise = this.hydrateFromIndexedDB();
  }

  async ensureHydrated(): Promise<void> {
    if (!this.hydrationPromise) {
      this.hydrationPromise = this.hydrateFromIndexedDB();
    }
    return this.hydrationPromise;
  }

  private async hydrateFromIndexedDB() {
    const keys = [
      'custom_publications', 
      'custom_videos', 
      'custom_marketplace', 
      'custom_artisans', 
      'my_likes',
      'deleted_publications_ids',
      'deleted_videos_ids',
      'deleted_marketplace_ids',
      'deleted_artisans_ids',
      'wallets',
      'wallet_transactions',
      'service_requests',
      'platform_settings',
      'registered_users'
    ];

    // 1. Load persisted data from IndexedDB into memoryCache
    for (const k of keys) {
      try {
        const val = await idbStorage.getItem(this.localKey(k));
        if (val !== null && val !== undefined) {
          this.memoryCache[this.localKey(k)] = val;
        }
      } catch {}
    }

    // 2. Proactive quota recovery: If bulky media/data exist in localStorage from previous versions,
    // ensure they are safely preserved in idbStorage, then remove them from localStorage
    // to guarantee maximum free storage space for Supabase Auth tokens on Android Chrome / iOS.
    try {
      if (typeof window !== 'undefined' && window.localStorage) {
        const heavyPrefixes = [
          'artisanpro_custom_videos',
          'artisanpro_custom_publications',
          'artisanpro_custom_marketplace',
          'artisanpro_msgs_',
          'artisanpro_convs_',
          'artisanpro_admin_reports',
          'artisanpro_subscription_proofs',
          'artisanpro_service_requests'
        ];

        const keysToClean: string[] = [];
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i);
          if (k && heavyPrefixes.some(prefix => k.startsWith(prefix))) {
            keysToClean.push(k);
          }
        }

        for (const k of keysToClean) {
          try {
            const raw = localStorage.getItem(k);
            if (raw) {
              const parsed = JSON.parse(raw);
              if (this.memoryCache[k] === undefined) {
                this.memoryCache[k] = parsed;
              }
              // Save to IndexedDB if not already there
              idbStorage.setItem(k, parsed).catch(() => {});
            }
            localStorage.removeItem(k);
          } catch {}
        }
      }
    } catch {}
  }

  private purgeDemoFollowersAndLikes() {
    try {
      const keysToClean: string[] = [];
      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && (key.includes('followers_count_') || key.includes('likes_count_'))) {
          keysToClean.push(key);
        }
      }
      for (const k of keysToClean) {
        const raw = localStorage.getItem(k);
        if (raw) {
          try {
            const num = Number(JSON.parse(raw));
            if (num === 42 || num === 98 || (num >= 24 && num <= 230)) {
              localStorage.setItem(k, JSON.stringify(0));
            }
          } catch {}
        }
      }
    } catch {}
  }

  private cleanUpKonanTest() {
    try {
      const reg = this.getStored<UserProfile[]>('registered_users', []);
      const filtered = reg.filter(u => {
        const name = `${u.full_name || ''} ${u.nom || ''}`.toLowerCase();
        return !name.includes('konan') && !u.email.toLowerCase().includes('konan');
      });
      if (filtered.length !== reg.length) {
        this.setStored('registered_users', filtered);
      }

      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && (key.toLowerCase().includes('konan') || key.startsWith('artisanpro_profile_'))) {
          const val = localStorage.getItem(key);
          if (val && val.toLowerCase().includes('konan')) {
            localStorage.removeItem(key);
          }
        }
      }

      // Silent Supabase cleanup
      Promise.resolve(supabase.from('profiles').delete().ilike('full_name', '%konan%')).catch(() => {});
      Promise.resolve(supabase.from('artisans').delete().ilike('nom', '%konan%')).catch(() => {});
    } catch {}
  }

  private localKey(key: string) {
    return `artisanpro_${key}`;
  }

  getStored<T>(key: string, defaultVal: T): T {
    const fullKey = this.localKey(key);
    if (this.memoryCache[fullKey] !== undefined) {
      return this.memoryCache[fullKey];
    }
    try {
      const item = localStorage.getItem(fullKey);
      if (item) {
        const parsed = JSON.parse(item);
        this.memoryCache[fullKey] = parsed;
        return parsed;
      }
    } catch {}
    return defaultVal;
  }

  setStored<T>(key: string, value: T): void {
    const fullKey = this.localKey(key);
    this.memoryCache[fullKey] = value;
    // Always persist to IndexedDB asynchronously (handles large video data URLs without 5MB quota errors)
    idbStorage.setItem(fullKey, value).catch(() => {});

    // Bulky keys that typically contain base64 images or videos are NEVER written to localStorage.
    // They are preserved in memoryCache and IndexedDB, keeping localStorage 100% available for Supabase Auth.
    const isHeavyKey = 
      key.startsWith('custom_') || 
      key.startsWith('msgs_') || 
      key.startsWith('convs_') ||
      key.startsWith('admin_reports') ||
      key.startsWith('subscription_proofs') ||
      key.startsWith('service_requests') ||
      key === 'registered_users';

    if (isHeavyKey) {
      try {
        localStorage.removeItem(fullKey);
      } catch {}
      return;
    }

    try {
      const serialized = JSON.stringify(value);
      // Skip localStorage if payload is larger than 5 KB to guarantee free space for Supabase Auth
      if (serialized.length > 5000) {
        try { localStorage.removeItem(fullKey); } catch {}
        return;
      }
      localStorage.setItem(fullKey, serialized);
    } catch (e) {
      console.warn('LocalStorage quota reached (safely stored in IndexedDB):', e);
    }
  }

  resolveUserUuid(userId?: string | null): string | null {
    if (!userId) return null;
    const clean = userId.trim();
    if (clean === 'admin-adanmitondejunior07') {
      return '29a23578-640c-434c-bb7c-5b1cb7a30a91';
    }
    const isUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(clean);
    if (isUuid) return clean;
    const reg = this.getStored<UserProfile[]>('registered_users', []);
    const found = reg.find(u => u.id === clean || (u.email && u.email.toLowerCase() === clean.toLowerCase()));
    if (found && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(found.id)) {
      return found.id;
    }
    return null;
  }

  // PUBLICATIONS (POSTS)
  async getPublications(currentUserId?: string): Promise<Publication[]> {
    await this.ensureHydrated();
    const resolvedUserId = this.resolveUserUuid(currentUserId);
    try {
      // 1. Fetch from Supabase publications table
      const { data, error } = await supabase
        .from('publications')
        .select('*')
        .order('created_at', { ascending: false });

      // 2. Fetch real likes from Supabase likes table
      let dbLikes: { post_id: string; user_id: string }[] = [];
      let likesFetchedOk = false;
      try {
        const { data: likesData, error: likesError } = await supabase
          .from('likes')
          .select('post_id, user_id');
        if (!likesError && likesData) {
          dbLikes = likesData;
          likesFetchedOk = true;
        }
      } catch (e) {
        console.warn('Error reading likes from Supabase:', e);
      }

      const likesCountMap = new Map<string, number>();
      const userLikedSet = new Set<string>();
      for (const l of dbLikes) {
        if (l.post_id) {
          likesCountMap.set(l.post_id, (likesCountMap.get(l.post_id) || 0) + 1);
          if (resolvedUserId && l.user_id === resolvedUserId) {
            userLikedSet.add(l.post_id);
          }
        }
      }

      const userLikesKey = currentUserId ? `my_likes_${currentUserId}` : 'my_likes';
      const localLikes = this.getStored<string[]>(userLikesKey, this.getStored<string[]>('my_likes', []));
      const localCached = this.getStored<Publication[]>('custom_publications', []);
      const deletedIds = this.getStored<string[]>('deleted_publications_ids', []);

      // If likes were fetched successfully from DB and user is authenticated, sync to local store
      if (likesFetchedOk && resolvedUserId) {
        this.setStored(userLikesKey, Array.from(userLikedSet));
        this.setStored('my_likes', Array.from(userLikedSet));
      }

      let allPubs: Publication[] = [];

      if (!error && data && data.length > 0) {
        // Map Supabase rows to Publication with real counts from Supabase
        const supaPubs: Publication[] = data.map(row => {
          const count = likesFetchedOk
            ? (likesCountMap.get(row.id) ?? 0)
            : this.getStored<number>(`post_likes_${row.id}`, 0);

          const isLiked = resolvedUserId
            ? (likesFetchedOk ? userLikedSet.has(row.id) : (userLikedSet.has(row.id) || localLikes.includes(row.id)))
            : false;

          // Keep post likes count cache up-to-date
          if (likesFetchedOk) {
            this.setStored(`post_likes_${row.id}`, count);
          }

          return {
            id: row.id,
            artisan_name: row.artisan_name || 'Artisan Anonyme',
            artisan_avatar: row.artisan_avatar || null,
            location: row.location || 'Afrique',
            content: row.content || '',
            media_url: row.media_url || null,
            media_type: row.media_type || 'image',
            created_at: row.created_at,
            likes_count: count,
            comments_count: 0,
            is_liked_by_me: isLiked
          };
        });
        // Live Supabase publications take priority
        allPubs = [...supaPubs, ...localCached, ...INITIAL_PUBLICATIONS];
      } else {
        allPubs = [...localCached, ...INITIAL_PUBLICATIONS];
      }

      // De-duplicate by ID and filter out deleted posts
      const seen = new Set<string>();
      const deduped: Publication[] = [];
      for (const p of allPubs) {
        if (!seen.has(p.id) && !deletedIds.includes(p.id)) {
          seen.add(p.id);
          const realCount = likesFetchedOk
            ? (likesCountMap.has(p.id) ? likesCountMap.get(p.id)! : 0)
            : this.getStored<number>(`post_likes_${p.id}`, p.likes_count ?? 0);

          const isLiked = resolvedUserId
            ? (likesFetchedOk ? userLikedSet.has(p.id) : (userLikedSet.has(p.id) || localLikes.includes(p.id)))
            : false;

          deduped.push({
            ...p,
            likes_count: realCount,
            is_liked_by_me: isLiked
          });
        }
      }
      return deduped;
    } catch (err) {
      console.error('getPublications error:', err);
      return INITIAL_PUBLICATIONS;
    }
  }

  async createPublication(pub: Omit<Publication, 'id' | 'created_at'>): Promise<Publication> {
    const generatedUuid = typeof crypto !== 'undefined' && crypto.randomUUID
      ? crypto.randomUUID()
      : '00000000-0000-4000-8000-' + Math.random().toString(16).substring(2, 14).padEnd(12, '0');

    const newPub: Publication = {
      ...pub,
      id: generatedUuid,
      created_at: new Date().toISOString(),
      likes_count: 0,
      comments_count: 0,
      is_liked_by_me: false
    };

    // Try inserting into Supabase publications table (if not a huge base64 payload)
    if (!pub.media_url || !pub.media_url.startsWith('data:')) {
      try {
        const { data, error } = await supabase.from('publications').insert({
          id: generatedUuid,
          artisan_name: pub.artisan_name,
          artisan_avatar: pub.artisan_avatar || null,
          location: pub.location || null,
          content: pub.content,
          media_url: pub.media_url || null,
          media_type: pub.media_type || 'image'
        }).select().single();

        if (!error && data) {
          newPub.id = data.id;
          newPub.created_at = data.created_at;
        }
      } catch (e) {
        console.warn('Supabase publication insert error, fallback local:', e);
      }
    }

    const current = this.getStored<Publication[]>('custom_publications', []);
    this.setStored('custom_publications', [newPub, ...current]);

    // Mirror video publications into custom_videos so they appear in Video Reels as well
    if (pub.media_type === 'video' && pub.media_url) {
      const curVids = this.getStored<VideoItem[]>('custom_videos', []);
      const newVid: VideoItem = {
        id: newPub.id,
        title: pub.content ? pub.content.slice(0, 80) : 'Vidéo de réalisation artisanale',
        video_url: pub.media_url,
        artisan_name: pub.artisan_name,
        artisan_avatar: pub.artisan_avatar || undefined,
        metier: 'Artisan',
        ville: pub.location || 'Afrique',
        likes_count: 0,
        comments_count: 0,
        created_at: newPub.created_at,
        user_id: pub.user_id
      };
      this.setStored('custom_videos', [newVid, ...curVids]);
    }

    return newPub;
  }

  async updatePublication(postId: string, updates: Partial<Publication>): Promise<Publication | null> {
    const current = this.getStored<Publication[]>('custom_publications', []);
    const idx = current.findIndex(p => p.id === postId);
    if (idx >= 0) {
      current[idx] = { ...current[idx], ...updates };
      this.setStored('custom_publications', current);

      // Also update in custom_videos if mirrored
      const vids = this.getStored<VideoItem[]>('custom_videos', []);
      const vIdx = vids.findIndex(v => v.id === postId);
      if (vIdx >= 0) {
        if (updates.content) vids[vIdx].title = updates.content.slice(0, 80);
        if (updates.media_url) vids[vIdx].video_url = updates.media_url;
        this.setStored('custom_videos', vids);
      }
      return current[idx];
    }
    return null;
  }

  async updateUserPublicationsAuthor(authorId: string, newName: string, newAvatar?: string, oldName?: string): Promise<void> {
    await this.ensureHydrated();
    const canonicalId = this.resolveUserUuid(authorId) || authorId;
    const cleanOld = (oldName || '').trim().toLowerCase();

    // 1. Update in-memory and custom_publications
    const pubs = this.getStored<Publication[]>('custom_publications', []);
    let updatedAny = false;
    const updatedPubs = pubs.map(p => {
      const isAuthor = 
        (p.user_id && (p.user_id === authorId || p.user_id === canonicalId)) ||
        (cleanOld && p.artisan_name && p.artisan_name.trim().toLowerCase() === cleanOld) ||
        (canonicalId === '29a23578-640c-434c-bb7c-5b1cb7a30a91' && (p.artisan_name?.includes('Adanmitonde') || cleanOld.includes('adanmitonde')));
      if (isAuthor) {
        updatedAny = true;
        return {
          ...p,
          artisan_name: newName,
          artisan_avatar: newAvatar || p.artisan_avatar
        };
      }
      return p;
    });
    if (updatedAny) {
      this.setStored('custom_publications', updatedPubs);
    }

    // 2. Also update in custom_videos
    const vids = this.getStored<VideoItem[]>('custom_videos', []);
    let vidsUpdated = false;
    const updatedVids = vids.map(v => {
      const isAuthor = 
        (v.user_id && (v.user_id === authorId || v.user_id === canonicalId)) ||
        (cleanOld && v.artisan_name && v.artisan_name.trim().toLowerCase() === cleanOld) ||
        (canonicalId === '29a23578-640c-434c-bb7c-5b1cb7a30a91' && (v.artisan_name?.includes('Adanmitonde') || cleanOld.includes('adanmitonde')));
      if (isAuthor) {
        vidsUpdated = true;
        return {
          ...v,
          artisan_name: newName,
          artisan_avatar: newAvatar || v.artisan_avatar
        };
      }
      return v;
    });
    if (vidsUpdated) {
      this.setStored('custom_videos', updatedVids);
    }

    // 3. Update Supabase publications table (matching oldName or founder name)
    try {
      const updatePayload: any = { artisan_name: newName };
      if (newAvatar) updatePayload.artisan_avatar = newAvatar;

      if (oldName && oldName.trim() && oldName.trim() !== newName.trim()) {
        await supabase.from('publications').update(updatePayload).eq('artisan_name', oldName.trim());
      }
      if (canonicalId === '29a23578-640c-434c-bb7c-5b1cb7a30a91') {
        await supabase.from('publications').update(updatePayload).ilike('artisan_name', '%Adanmitonde%');
      }
    } catch (err) {
      console.warn('Supabase update publications author note:', err);
    }
  }

  async deletePublication(postId: string): Promise<boolean> {
    try {
      const current = this.getStored<Publication[]>('custom_publications', []);
      this.setStored('custom_publications', current.filter(p => p.id !== postId));

      const vids = this.getStored<VideoItem[]>('custom_videos', []);
      this.setStored('custom_videos', vids.filter(v => v.id !== postId));

      const deletedIds = this.getStored<string[]>('deleted_publications_ids', []);
      if (!deletedIds.includes(postId)) {
        this.setStored('deleted_publications_ids', [...deletedIds, postId]);
      }

      // Try Supabase delete
      try {
        await supabase.from('publications').delete().eq('id', postId);
      } catch (err) {
        // silent
      }

      return true;
    } catch (e) {
      console.warn('deletePublication error:', e);
      return false;
    }
  }

  async toggleLike(postId: string, userId?: string): Promise<{ isLiked: boolean; count: number }> {
    const resolvedUserId = this.resolveUserUuid(userId);
    const userLikesKey = userId ? `my_likes_${userId}` : 'my_likes';
    const localLikes = this.getStored<string[]>(userLikesKey, this.getStored<string[]>('my_likes', []));

    const isPostUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(postId);
    let isLiked = localLikes.includes(postId);
    let updatedCount: number | null = null;

    // Sync to Supabase likes table if user is authenticated with a valid UUID and post has valid UUID
    if (resolvedUserId && isPostUuid) {
      try {
        // 1. Check if like already exists in public.likes for (postId, resolvedUserId)
        const { data: existingLikes, error: searchErr } = await supabase
          .from('likes')
          .select('id')
          .eq('post_id', postId)
          .eq('user_id', resolvedUserId);

        const alreadyLiked = !searchErr && existingLikes && existingLikes.length > 0;

        if (alreadyLiked) {
          // Action: UNLIKE -> Delete from Supabase public.likes
          const { error: delErr } = await supabase
            .from('likes')
            .delete()
            .eq('post_id', postId)
            .eq('user_id', resolvedUserId);

          if (!delErr) {
            isLiked = false;
          }
        } else {
          // Action: LIKE -> Insert into Supabase public.likes (preventing duplicates)
          const { error: insErr } = await supabase
            .from('likes')
            .insert({
              post_id: postId,
              user_id: resolvedUserId
            });

          // If inserted successfully or duplicate caught by DB constraint (code 23505)
          if (!insErr || (insErr as { code?: string }).code === '23505') {
            isLiked = true;
          }
        }

        // 2. Fetch exact real count of likes from Supabase
        const { count, error: countErr } = await supabase
          .from('likes')
          .select('*', { count: 'exact', head: true })
          .eq('post_id', postId);

        if (!countErr && typeof count === 'number') {
          updatedCount = count;
        }
      } catch (e) {
        console.warn('Supabase like error, fallback local:', e);
        isLiked = !isLiked;
      }
    } else {
      isLiked = !isLiked;
    }

    const currentPostLikes = this.getStored<number>(`post_likes_${postId}`, 0);
    const finalCount = updatedCount !== null
      ? updatedCount
      : (isLiked ? currentPostLikes + 1 : Math.max(0, currentPostLikes - 1));

    const updated = isLiked 
      ? Array.from(new Set([...localLikes, postId]))
      : localLikes.filter(id => id !== postId);

    this.setStored(userLikesKey, updated);
    this.setStored('my_likes', updated);
    this.setStored(`post_likes_${postId}`, finalCount);

    // Also update custom_publications directly so publication likes NEVER disappear
    const customPubs = this.getStored<Publication[]>('custom_publications', []);
    const updatedCustomPubs = customPubs.map(p => p.id === postId ? { ...p, likes_count: finalCount, is_liked_by_me: isLiked } : p);
    this.setStored('custom_publications', updatedCustomPubs);

    return { isLiked, count: finalCount };
  }

  // VIDEO LIKES: RESOLVES REAL PUBLICATION ROW IN SUPABASE TO GUARANTEE FOREIGN KEY COMPLIANCE
  async toggleVideoLike(videoId: string, userId?: string): Promise<{ isLiked: boolean; count: number; error?: string }> {
    if (!userId) {
      return { isLiked: false, count: 0, error: 'unauthenticated' };
    }
    await this.ensureHydrated();
    const resolvedUserId = this.resolveUserUuid(userId);
    const userLikesKey = `my_likes_${userId}`;
    const localLikes = this.getStored<string[]>(userLikesKey, this.getStored<string[]>('my_likes', []));

    // Determine target publication row in Supabase 'publications'
    let targetPubId: string | null = null;
    let isLiked = localLikes.includes(videoId);

    const isVideoUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(videoId);

    // 1. Check if videoId itself exists in Supabase publications
    if (isVideoUuid) {
      try {
        const { data: pubMatch } = await supabase
          .from('publications')
          .select('id')
          .eq('id', videoId)
          .maybeSingle();
        if (pubMatch?.id) {
          targetPubId = pubMatch.id;
        }
      } catch (err) {
        console.warn('Check pub by id note:', err);
      }
    }

    // 2. If not found by direct ID, locate video from local stores or Supabase
    if (!targetPubId) {
      const allVideos = this.getStored<VideoItem[]>('custom_videos', []);
      const matchedVid = allVideos.find(v => v.id === videoId);

      if (matchedVid && matchedVid.video_url) {
        try {
          const { data: byUrl } = await supabase
            .from('publications')
            .select('id')
            .eq('media_url', matchedVid.video_url)
            .maybeSingle();

          if (byUrl?.id) {
            targetPubId = byUrl.id;
          } else {
            // Ensure mirrored row exists in publications so foreign key constraint succeeds
            const newPubId = isVideoUuid
              ? videoId
              : (typeof crypto !== 'undefined' && crypto.randomUUID
                  ? crypto.randomUUID()
                  : '00000000-0000-4000-8000-' + Math.random().toString(16).substring(2, 14).padEnd(12, '0'));
            const { error: insPubErr } = await supabase
              .from('publications')
              .insert({
                id: newPubId,
                artisan_name: matchedVid.artisan_name || 'Artisan Créateur',
                artisan_avatar: matchedVid.artisan_avatar || null,
                location: matchedVid.ville || 'Afrique',
                content: matchedVid.title || 'Vidéo artisanale',
                media_url: matchedVid.video_url,
                media_type: 'video',
                created_at: matchedVid.created_at || new Date().toISOString()
              });
            if (!insPubErr) {
              targetPubId = newPubId;
            }
          }
        } catch (e) {
          console.warn('Error matching video to publication row:', e);
        }
      }
    }

    let updatedCount: number | null = null;

    // 3. If a valid publication row was resolved and user is authenticated with UUID, interact with 'likes' table
    if (targetPubId && resolvedUserId) {
      try {
        const { data: existingLike, error: findErr } = await supabase
          .from('likes')
          .select('id')
          .eq('post_id', targetPubId)
          .eq('user_id', resolvedUserId)
          .maybeSingle();

        const alreadyLiked = !findErr && Boolean(existingLike);

        if (alreadyLiked) {
          // Unlike
          const { error: delErr } = await supabase
            .from('likes')
            .delete()
            .eq('post_id', targetPubId)
            .eq('user_id', resolvedUserId);

          if (!delErr) {
            isLiked = false;
          }
        } else {
          // Like
          const { error: insErr } = await supabase
            .from('likes')
            .insert({
              post_id: targetPubId,
              user_id: resolvedUserId
            });

          if (!insErr || (insErr as any).code === '23505') {
            isLiked = true;
          }
        }

        // Recalculate real count from Supabase
        const { count, error: countErr } = await supabase
          .from('likes')
          .select('*', { count: 'exact', head: true })
          .eq('post_id', targetPubId);

        if (!countErr && typeof count === 'number') {
          updatedCount = count;
        }
      } catch (err) {
        console.warn('Error syncing video like with Supabase:', err);
        isLiked = !isLiked;
      }
    } else {
      isLiked = !isLiked;
    }

    const currentPostLikes = this.getStored<number>(`post_likes_${videoId}`, 0);
    const finalCount = updatedCount !== null
      ? updatedCount
      : (isLiked ? currentPostLikes + 1 : Math.max(0, currentPostLikes - 1));

    // Update local storage for both keys (videoId and targetPubId)
    const updated = isLiked 
      ? Array.from(new Set([...localLikes, videoId, ...(targetPubId ? [targetPubId] : [])]))
      : localLikes.filter(id => id !== videoId && id !== targetPubId);

    this.setStored(userLikesKey, updated);
    this.setStored('my_likes', updated);
    this.setStored(`post_likes_${videoId}`, finalCount);
    if (targetPubId && targetPubId !== videoId) {
      this.setStored(`post_likes_${targetPubId}`, finalCount);
    }

    // Update video item in custom_videos
    const customVideos = this.getStored<VideoItem[]>('custom_videos', []);
    const updatedVids = customVideos.map(v => 
      (v.id === videoId || (targetPubId && v.id === targetPubId))
        ? { ...v, likes_count: finalCount, is_liked: isLiked }
        : v
    );
    this.setStored('custom_videos', updatedVids);

    return { isLiked, count: finalCount };
  }

